# =============================================================
# Flash-Archi Frontend — variables d'environnement
# Copier ce fichier en .env pour l'adapter (jamais versionné).
# Aucun secret requis : la clé API est saisie côté client.
# =============================================================

# URL de l'API (optionnelle).
#  - Vide (défaut)  : le frontend appelle /api/** relatif → reverse-proxy
#    NPM (production) ou proxy Vite (développement, cf. vite.config.ts).
#  - Renseignée     : le frontend appel l'API sur une URL absolue (dev
#    isolé, autre domaine autorisé côté CORS).
VITE_API_BASE=

# Cible du proxy de DEV du serveur Vite (lorsque npm run dev).
# Attention : mise en correspondance directe — ne pas y mettre de secret.
VITE_DEV_API_TARGET=http://localhost:8080

# Activer le mode démo (side-car) — non utilisé au MVP.
VITE_ENABLE_DEMO=false